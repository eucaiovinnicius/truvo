    "@truvo/event-schema": "workspace:*",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "ua-parser-js": "^1.0.38"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ua-parser-js": "^0.7.39",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
