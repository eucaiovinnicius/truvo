{
  "name": "truvo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@8.5.1",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:pull": "docker compose -f infra/docker-compose.yml pull",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:pg": "pnpm --filter @truvo/db db:migrate",
    "db:pg:adopt-baseline": "pnpm --filter @truvo/db db:adopt-baseline",
    "db:backfill:customer-context": "pnpm --filter @truvo/db db:backfill:customer-context",
    "db:ch": "pnpm --filter @truvo/db ch:migrate",
    "db:setup": "pnpm db:pg && pnpm db:ch",
    "migration:validate": "node scripts/validate-migrations.mjs",
    "test:propensity": "node scripts/test-propensity-runtime.mjs",
    "test:model-registry": "node scripts/test-propensity-runtime.mjs",
    "test:propensity:python": "python -m unittest discover -s apps/propensity-worker/tests -t apps/propensity-worker -p test_core.py -v",
    "lint:propensity": "python -m ruff check apps/propensity-worker",
    "typecheck:propensity": "python -m mypy --config-file apps/propensity-worker/pyproject.toml apps/propensity-worker/propensity_worker",
    "release:identity": "node scripts/release-identity.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.4.5",
    "@types/node": "^20.14.0"
  }
}
