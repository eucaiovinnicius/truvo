{
  "name": "@truvo/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/postgres/migrate.ts",
    "db:adopt-baseline": "tsx src/postgres/migrate.ts --adopt-baseline",
    "db:backfill:customer-context": "tsx src/postgres/backfill-customer-context.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "ch:migrate": "tsx src/clickhouse/migrate.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.4.0",
    "drizzle-orm": "^0.32.1",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.23.2",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
