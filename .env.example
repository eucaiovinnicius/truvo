# ─── Supabase (Auth + Postgres) — projeto na nuvem (free tier) ───
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # NUNCA no frontend (regra 3)
DATABASE_URL="postgresql://postgres:<senha>@db.<project>.supabase.co:5432/postgres"

# ─── Auth interno server-to-server (consumer M2 → M8 identify) ───
# Segredo compartilhado; sem ele o forward de identidade do consumer fica desligado.
INTERNAL_API_SECRET="<hex-aleatorio-forte>"
# INTERNAL_API_URL="http://localhost:3333"   # opcional (default localhost:3333)

# ─── ClickHouse (Docker local) ───
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="truvo"
CLICKHOUSE_PASSWORD="truvo_local"
CLICKHOUSE_DB="truvo"

# ─── Redpanda / Kafka (Docker local) ───
KAFKA_BROKERS="localhost:9092"

# ─── Redis (Docker local) ───
REDIS_URL="redis://localhost:6379"

# ─── API (NestJS) ───
API_PORT="3333"

# ─── Web (Next.js) ───
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ─── M2 Event Pipeline (ingestão + consumer) ───
KAFKA_EVENTS_TOPIC="truvo.events"
CONSUMER_GROUP_ID="truvo-consumer"
EVENT_ID_DEDUP_TTL="86400"          # segundos (24h)
CH_BATCH_MAX_ROWS="100"
CH_BATCH_MAX_DELAY_MS="1000"
RATE_LIMIT_EVENTS_PER_MIN="60000"

# ─── M4 Webhooks / Integrações ───
INTEGRATIONS_ENCRYPTION_KEY=""      # >=32 bytes p/ AES-256-GCM (obrigatório p/ cifrar credenciais)
WEBHOOK_RATE_LIMIT="600"            # hits/min por workspace
WEBHOOK_RETRY_SCAN_MS="60000"

# ─── M3 Tracking (dev, opcionais) ───
TRUVO_DEV_AUTH_BYPASS=""            # =1 só em dev; NUNCA em prod
PIXEL_JS_PATH=""                    # caminho do bundle p/ servir /pixel.js em dev

# ─── M8 Identity (stitch worker, Redis stream) ───
IDENTITY_STITCH_STREAM="identity.stitch"
IDENTITY_STITCH_GROUP="identity-stitch-workers"
IDENTITY_STITCH_BATCH="16"
IDENTITY_STITCH_BLOCK_MS="5000"
IDENTITY_STITCH_RECLAIM_IDLE_MS="60000"

# ─── M14 Qualidade de dados ───
RECONCILIATION_GAP_THRESHOLD="0.02"
DATA_QUALITY_DATACENTER_CIDRS=""    # CIDRs de datacenter p/ bot filter (vazio=off)
BOT_MAX_EVENTS_PER_SECOND="8"
BOT_MAX_REQUESTS_PER_MINUTE="600"

# ─── M5 Funnels ───
FUNNEL_ALERT_WINDOW_DAYS="7"
FUNNEL_ALERT_MIN_SAMPLE="20"

# ─── M15 Customer 360 ───
PROFILE_PROJECTION_TTL_SECONDS="300"

# ─── M16 Data Explorer (SQL guardado — pool de leitura isolado; opcionais, fail-closed) ───
CLICKHOUSE_READ_URL=""              # réplica de leitura p/ queries self-serve (vazio=usa a padrão)
EXPLORER_CH_URL=""                  # cluster/pool isolado do SQL guardado (vazio=/sql responde 503)
EXPLORER_CH_USER=""                 # usuário readonly=1 do sandbox
EXPLORER_CH_PASSWORD=""
EXPLORER_CH_DB=""

# ─── M9 Integrações-out (Meta CAPI / Google / TikTok) — reusa INTEGRATIONS_ENCRYPTION_KEY ───
META_GRAPH_VERSION="v19.0"
GOOGLE_ADS_API_VERSION="v17"
TIKTOK_API_VERSION="v1.3"
OUTBOUND_HTTP_TIMEOUT_MS="8000"

# ─── M10 Creative Analytics (Ads APIs — fail-closed sem credenciais/aprovações) ───
META_ADS_ACCESS_TOKEN=""
META_ADS_API_VERSION="v21.0"
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
TIKTOK_ADS_ACCESS_TOKEN=""
TIKTOK_ADS_API_VERSION="v1.3"
CREATIVE_FATIGUE_ROAS_DROP="0.30"
CREATIVE_DISCREPANCY_DELTA="0.50"
CREATIVE_TOP_ROAS="5"
CREATIVE_TOP_DAYS="7"
CREATIVE_SPEND_NO_CONVERSION="500"
CREATIVE_FATIGUE_MIN_SPEND="50"

# ─── M12 Notificações (email/Slack) ───
NOTIFICATIONS_EMAIL_PROVIDER=""    # resend | postmark | "" (off)
NOTIFICATIONS_EMAIL_FROM=""
RESEND_API_KEY=""
POSTMARK_API_TOKEN=""
POSTMARK_MESSAGE_STREAM="outbound"

# ─── Scheduler de jobs (crons: billing/alertas/reconciliação/ads-sync) ───
# =1 liga a varredura periódica (atrás de leader-lock Redis; 1 réplica dispara).
# Default OFF; a infra de produção liga com 1.
SCHEDULER_ENABLED="0"

# ─── M13 Relatórios ───
REPORTS_PUBLIC_BASE_URL="https://app.truvo.com"
REPORTS_EMAIL_FROM=""
REPORTS_SCHEDULER_ENABLED="0"
REPORTS_SCHEDULER_SCAN_MS="60000"

# ─── M11 Billing (Stripe) ───
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_API_VERSION=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_AGENCY=""
STRIPE_PRICE_ENTERPRISE=""
BILLING_DEFAULT_PLAN="starter"
BILLING_USAGE_ALERT_THRESHOLD="0.8"
BILLING_APP_URL="http://localhost:3000"
BILLING_CHECKOUT_SUCCESS_URL="http://localhost:3000/billing?status=success"
BILLING_CHECKOUT_CANCEL_URL="http://localhost:3000/billing?status=cancel"
BILLING_PORTAL_RETURN_URL="http://localhost:3000/billing"

# ─── M17 AI Journey Intelligence (Claude / Anthropic) ───
ANTHROPIC_API_KEY=""               # fail-closed: /ask responde 503; o evidence pack determinístico segue
