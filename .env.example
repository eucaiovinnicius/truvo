# ─── Supabase (Auth + Postgres) — projeto na nuvem (free tier) ───
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # NUNCA no frontend (regra 3)
DATABASE_URL="postgresql://postgres:<senha>@db.<project>.supabase.co:5432/postgres"

# ─── ClickHouse (Docker local) ───
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="truvo"
CLICKHOUSE_PASSWORD="truvo_local"
CLICKHOUSE_DB="truvo"

# ─── Redpanda / Kafka (Docker local) ───
KAFKA_BROKERS="localhost:9092"

# ─── Redis (Docker local) ───
REDIS_URL="redis://localhost:6379"

# ─── API (NestJS) ───
API_PORT="3333"

# ─── Web (Next.js) ───
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ─── M2 Event Pipeline (ingestão + consumer) ───
KAFKA_EVENTS_TOPIC="truvo.events"
CONSUMER_GROUP_ID="truvo-consumer"
EVENT_ID_DEDUP_TTL="86400"          # segundos (24h)
CH_BATCH_MAX_ROWS="100"
CH_BATCH_MAX_DELAY_MS="1000"
RATE_LIMIT_EVENTS_PER_MIN="60000"

# ─── M4 Webhooks / Integrações ───
INTEGRATIONS_ENCRYPTION_KEY=""      # >=32 bytes p/ AES-256-GCM (obrigatório p/ cifrar credenciais)
WEBHOOK_RATE_LIMIT="600"            # hits/min por workspace
WEBHOOK_RETRY_SCAN_MS="60000"

# ─── M3 Tracking (dev, opcionais) ───
TRUVO_DEV_AUTH_BYPASS=""            # =1 só em dev; NUNCA em prod
PIXEL_JS_PATH=""                    # caminho do bundle p/ servir /pixel.js em dev
